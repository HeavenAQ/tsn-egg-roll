<section class="section" id="pricing">
  <div class="site-width">
    <div class="section-title-wrap">
      <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      <div class="section-rule"></div>
    </div>

    <div class="pricing-grid">
      {% for block in section.blocks %}
        {% if block.type == 'plan' %}
          <article class="plan {% if block.settings.popular %}plan-popular{% else %}plan-plain{% endif %}">
            {% if block.settings.popular %}<div class="plan-badge">{{ section.settings.popular_badge }}</div>{% endif %}
            <h3>{{ block.settings.name }}</h3>
            <p>{{ block.settings.description }}</p>
            <div class="plan-price">{{ block.settings.price }}</div>

            <ul class="plan-list">
              {% if block.settings.item_1 != blank %}<li><span class="check">✓</span>{{ block.settings.item_1 }}</li>{% endif %}
              {% if block.settings.item_2 != blank %}<li><span class="check">✓</span>{{ block.settings.item_2 }}</li>{% endif %}
              {% if block.settings.item_3 != blank %}<li><span class="check">✓</span>{{ block.settings.item_3 }}</li>{% endif %}
              {% if block.settings.item_4 != blank %}<li><span class="check">✓</span>{{ block.settings.item_4 }}</li>{% endif %}
            </ul>

            <p>
              <a class="btn {% if block.settings.popular %}btn-light{% else %}btn-primary{% endif %}" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
            </p>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pricing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "価格プラン" },
    { "type": "text", "id": "popular_badge", "label": "Popular badge", "default": "おすすめ" }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "checkbox", "id": "popular", "label": "Popular", "default": false },
        { "type": "text", "id": "name", "label": "Name", "default": "パーソナル" },
        { "type": "text", "id": "description", "label": "Description", "default": "個人購入向け" },
        { "type": "text", "id": "price", "label": "Price", "default": "¥1,500" },
        { "type": "text", "id": "item_1", "label": "Item 1", "default": "からすみエッグロール 100g" },
        { "type": "text", "id": "item_2", "label": "Item 2", "default": "簡易パッケージ" },
        { "type": "text", "id": "item_3", "label": "Item 3", "default": "送料別" },
        { "type": "text", "id": "item_4", "label": "Item 4" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "今すぐ購入" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing",
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "popular": true,
            "name": "パーソナル",
            "description": "個人購入向け",
            "price": "¥1,500",
            "item_1": "からすみエッグロール 100g",
            "item_2": "簡易パッケージ",
            "item_3": "送料別",
            "button_label": "今すぐ購入"
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "エンタープライズ",
            "description": "法人・大量購入向け",
            "price": "カスタム",
            "item_1": "カスタムパッケージ対応",
            "item_2": "配送手配",
            "item_3": "専任担当者サポート",
            "button_label": "お問い合わせ"
          }
        }
      ]
    }
  ]
}
{% endschema %}
